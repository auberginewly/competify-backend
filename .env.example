# CompetifyAI Backend — 环境变量模板
# 复制为 .env 并填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交

# ──────────────────────────────────────
# LLM（必填，否则 Analyzer 全部走 stub）
# ──────────────────────────────────────
# DeepSeek（默认，兼容 OpenAI SDK）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL_NAME=deepseek-v4-pro

# 或直接用 OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL_NAME=gpt-4o-mini

# 调试用：跳过真实 LLM，所有 Analyzer 返回 stub 数据
# MOCK_LLM=true

# ──────────────────────────────────────
# 基础设施（默认指向 docker compose 服务）
# ──────────────────────────────────────
DGRAPH_ADDR=localhost:9080
NATS_ADDR=nats://localhost:4222
JAEGER_ENDPOINT=http://localhost:14268/api/traces
SERVER_PORT=8080

# ──────────────────────────────────────
# OpenViking（可选，不填则 Devil's Advocate 降级到启发式）
# ──────────────────────────────────────
VIKING_URL=http://localhost:8000
VIKING_API_KEY=

# ──────────────────────────────────────
# Tavily Search（推荐填写，不填则 Collector 降级为直接 HTTP 爬取）
# 免费额度：1000次/月，注册：https://app.tavily.com
# ──────────────────────────────────────
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx
